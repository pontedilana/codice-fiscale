<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         colors="true"
         stopOnFailure="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <env name="XDEBUG_MODE" value="coverage" />
    </php>

    <testsuites>
        <testsuite name="CodiceFiscale Test Suite">
            <directory phpVersion="8.1.0" phpVersionOperator=">=">test/</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src/CodiceFiscale/</directory>
        </include>
    </source>

    <coverage>
        <report>
            <clover outputFile="test/output/clover.xml"/>
            <html outputDirectory="test/output/html-coverage" lowUpperBound="50" highLowerBound="90"/>
        </report>
    </coverage>

    <logging>
        <testdoxHtml outputFile="test/output/testdox.html"/>
    </logging>
</phpunit>
