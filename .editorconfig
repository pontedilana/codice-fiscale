; top-most EditorConfig file
root = true

; Unix-style newlines
[*]
charset = utf-8
end_of_line = LF
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,html,twig,js,ts,scss,css,yaml}]
indent_style = space
indent_size = 4

[composer.json]
indent_style = space
indent_size = 4

[*.md]
max_line_length = 80
trim_trailing_whitespace = false

[*.{neon,neon.dist}]
indent_style = tab

[COMMIT_EDITMSG]
max_line_length = 0
